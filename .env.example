
# Project
COMPOSE_PROJECT_NAME=ehub
# -------------------------------------------------

# PostgreSQL
POSTGRES_DB=ehub
POSTGRES_USER=ehub
POSTGRES_PASSWORD=ehub_local_password

# port 5432 -> backend kết nối postgresql
POSTGRES_PORT=5432
# --------------------------------------------------

# MiniO
# --------------------------------------------------
MINIO_ROOT_USER=ehub_minio
MINIO_ROOT_PASSWORD=ehub_minio_local_password

# port 9000 -> backend gọi minio api để upload/download
MINIO_API_PORT=9000

# port 9001 -> giao diện quản trị minio trên trình duyệt
MINIO_CONSOLE_PORT=9001

# bucket ehub-media -> chưa video, ảnh khóa học.
MINIO_BUCKET=ehub-media
# --------------------------------------------------

